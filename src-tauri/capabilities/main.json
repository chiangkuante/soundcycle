{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Settings window: the app's commands and device-change events",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-ui-language",
    "allow-get-hotkey",
    "allow-device-rows",
    "allow-set-device-checked",
    "allow-switch-next",
    "allow-set-hotkey",
    "allow-pause-hotkeys",
    "allow-get-settings",
    "allow-update-settings"
  ]
}
